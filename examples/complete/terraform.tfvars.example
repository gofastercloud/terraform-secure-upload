name_prefix = "myapp"
region      = "us-east-1"

# Optional: use an existing customer-managed KMS key.
kms_key_arn = null

vpc_id                  = "vpc-0123456789abcdef0"
subnet_ids              = ["subnet-aaa", "subnet-bbb"]
address_allocation_ids  = ["eipalloc-aaa", "eipalloc-bbb"]
sftp_allowed_cidrs      = ["203.0.113.10/32"]
sftp_custom_hostname    = "sftp.example.com"
# Optional: creates the CNAME in this public Route 53 hosted zone.
sftp_route53_hosted_zone_id = null
sftp_users = [
  {
    username              = "partner-a"
    ssh_public_key        = "ssh-ed25519 AAAA... partner-a@example.com"
    home_directory_prefix = "/uploads/partner-a/"
  }
]

tags = {
  Environment = "dev"
}
